.stats-title {
  font-weight: 600;
  color: #33305e;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #7c5cff;
  text-shadow: 0 0 12rpx rgba(124, 92, 255, 0.3);
}

.stat-label {
  font-size: 24rpx;
  color: #9b96c2;
  margin-top: 8rpx;
}

.msg-row {
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(124, 92, 255, 0.12);
  padding-bottom: 18rpx;
}

.msg-row:last-child {
  border-bottom: none;
}

.msg-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.msg-name {
  font-weight: 600;
  color: #6a5cff;
}

.msg-content {
  color: #4a4672;
  margin: 12rpx 0;
  line-height: 1.6;
  word-break: break-all;
}

.del-btn {
  background: linear-gradient(135deg, #ff6ec7, #7c5cff);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin: 0;
}

.del-btn::after {
  border: none;
}
