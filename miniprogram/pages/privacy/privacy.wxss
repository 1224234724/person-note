page {
  background: #0d0b1e;
}

.container {
  height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 48rpx;
  border-bottom: 1rpx solid rgba(124, 92, 255, 0.3);
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 0 16rpx rgba(124, 92, 255, 0.8);
  margin-bottom: 16rpx;
}

.update-time {
  font-size: 24rpx;
  color: rgba(163, 158, 200, 0.7);
}

.section {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(124, 92, 255, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #7c5cff;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 26rpx;
  color: rgba(220, 215, 255, 0.85);
  line-height: 1.8;
}

.footer {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(163, 158, 200, 0.5);
}
