.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx 50rpx;
  background: linear-gradient(160deg, #4cc9f0 0%, #7c5cff 55%, #ff6ec7 100%);
  border-radius: 0 0 56rpx 56rpx;
  box-shadow: 0 16rpx 48rpx rgba(124, 92, 255, 0.4);
}

.hero-stars {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  letter-spacing: 12rpx;
  margin-bottom: 24rpx;
  text-shadow: 0 0 12rpx rgba(255, 255, 255, 0.8);
}

.avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 0 32rpx rgba(255, 255, 255, 0.55),
    0 8rpx 24rpx rgba(26, 20, 68, 0.35);
}

.name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-shadow:
    0 0 16rpx rgba(255, 255, 255, 0.5),
    0 2rpx 8rpx rgba(26, 20, 68, 0.4);
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero .btn {
  width: 70%;
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #7c5cff;
  font-weight: 600;
  box-shadow:
    0 8rpx 24rpx rgba(26, 20, 68, 0.25),
    0 0 20rpx rgba(255, 255, 255, 0.4);
}

.logout {
  background: rgba(255, 255, 255, 0.25) !important;
  color: #fff !important;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.about-title {
  font-weight: 600;
  margin-bottom: 14rpx;
  color: #33305e;
}

.about-text {
  line-height: 1.7;
  color: #8a85b5;
}
