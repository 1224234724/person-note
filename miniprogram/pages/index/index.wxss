.banner {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  box-shadow: 0 16rpx 48rpx rgba(80, 60, 180, 0.25);
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  background: linear-gradient(180deg, transparent, rgba(26, 20, 68, 0.75));
}

.banner-text {
  position: absolute;
  left: 40rpx;
  bottom: 36rpx;
}

.banner-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  text-shadow:
    0 0 16rpx rgba(124, 92, 255, 0.9),
    0 4rpx 16rpx rgba(26, 20, 68, 0.6);
  letter-spacing: 4rpx;
  animation: neonPulse 2.4s ease-in-out infinite;
}

.banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 8rpx rgba(26, 20, 68, 0.5);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #33305e;
}

.summary {
  margin-top: 12rpx;
  color: #8a85b5;
  font-size: 26rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meta {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card {
  transition: transform 0.2s;
}

.card:active {
  transform: scale(0.98);
}

/* 飘落粒子 */
.particles {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 10;
}

.p {
  position: absolute;
  color: rgba(124, 92, 255, 0.45);
  font-size: 24rpx;
  top: -40rpx;
  animation: fall linear infinite;
}

.p1 { left: 10%; animation-duration: 6s; animation-delay: 0s; font-size: 28rpx; }
.p2 { left: 22%; animation-duration: 8s; animation-delay: 1s; color: rgba(76, 201, 240, 0.4); }
.p3 { left: 35%; animation-duration: 7s; animation-delay: 2.5s; font-size: 32rpx; }
.p4 { left: 48%; animation-duration: 9s; animation-delay: 0.5s; color: rgba(255, 110, 199, 0.35); }
.p5 { left: 60%; animation-duration: 6.5s; animation-delay: 3s; font-size: 26rpx; }
.p6 { left: 72%; animation-duration: 8.5s; animation-delay: 1.5s; color: rgba(76, 201, 240, 0.45); }
.p7 { left: 84%; animation-duration: 7.5s; animation-delay: 4s; font-size: 30rpx; }
.p8 { left: 94%; animation-duration: 10s; animation-delay: 2s; color: rgba(255, 110, 199, 0.4); }

@keyframes fall {
  0% { transform: translateY(-40rpx) rotate(0deg); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 0.8; }
  100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
}

@keyframes neonPulse {
  0%, 100% { text-shadow: 0 0 16rpx rgba(124, 92, 255, 0.9), 0 4rpx 16rpx rgba(26, 20, 68, 0.6); }
  50% { text-shadow: 0 0 28rpx rgba(124, 92, 255, 1), 0 0 40rpx rgba(76, 201, 240, 0.7), 0 4rpx 16rpx rgba(26, 20, 68, 0.6); }
}
