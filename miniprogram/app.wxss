page {
  background: linear-gradient(160deg, #eef1ff 0%, #fdeef7 50%, #e8f7ff 100%);
  font-size: 28rpx;
  color: #33305e;
}

/* 玻璃拟态卡片 + 彩色流光边 */
.card {
  background: rgba(255, 255, 255, 0.75);
  border-radius: 32rpx;
  padding: 30rpx;
  margin: 24rpx 28rpx;
  box-shadow:
    0 8rpx 32rpx rgba(124, 92, 255, 0.14),
    0 2rpx 8rpx rgba(76, 201, 240, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #6a5cff;
  background: linear-gradient(135deg, #e0e7ff, #d5f0ff);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  margin-right: 12rpx;
  border: 2rpx solid rgba(106, 92, 255, 0.25);
  box-shadow: 0 2rpx 8rpx rgba(106, 92, 255, 0.12);
}

.muted {
  color: #9b96c2;
  font-size: 24rpx;
}

/* 霓虹渐变按钮 + 光晕 */
.btn {
  background: linear-gradient(135deg, #4cc9f0, #7c5cff 55%, #ff6ec7);
  background-size: 200% 200%;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow:
    0 8rpx 28rpx rgba(124, 92, 255, 0.45),
    0 0 24rpx rgba(76, 201, 240, 0.25);
  border: none;
  font-weight: 600;
  letter-spacing: 2rpx;
  animation: gradientShift 3s ease infinite;
}

.btn::after {
  border: none;
}

.btn[disabled] {
  opacity: 0.6;
  color: #fff;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.empty {
  text-align: center;
  color: #a5a0cc;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 流光渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #4cc9f0, #7c5cff 50%, #ff6ec7);
  -webkit-background-clip: text;
  color: transparent;
}
